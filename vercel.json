{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "src/api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "src/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "src/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "src/*.webmanifest",
      "use": "@vercel/static"
    }
  ]
}