# ═══════════════════════════════════════════════════════════════
# LeetCode Auto-Solver — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── AUTO-LOGIN (replaces manual cookie copying forever) ───────
LEETCODE_USERNAME=YunuZCodes
LEETCODE_PASSWORD=your_leetcode_password_here

# ── GitHub PAT (so the bot can update its own secrets) ────────
# Create at: github.com → Settings → Developer Settings → Personal Access Tokens → Fine-grained
# Permissions needed: Read/Write access to "Secrets" and "Actions"
GH_PAT=github_pat_xxxxxxxxxxxx

# ── Gemini AI (generates solutions for uncached problems) ─────
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── These get auto-managed by the token refresher ────────────
# You do NOT need to set these manually anymore!
# LEETCODE_SESSION=auto_managed
# LEETCODE_CSRF_TOKEN=auto_managed

# ── Optional Config ──────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
SOLUTION_LANGUAGE=python3
DRY_RUN=false
SKIP_IF_SOLVED=true
